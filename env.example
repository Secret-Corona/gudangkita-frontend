# Environment Variables for GudangKita Frontend

# API Base URL
VITE_API_BASE_URL=http://localhost:3000/api

# App Configuration
VITE_APP_NAME=GudangKita
VITE_APP_VERSION=1.0.0

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key

# Features
VITE_ENABLE_PUBLIC_REQUESTS=true
VITE_ENABLE_REAL_TIME=true

# Development
VITE_DEBUG=false 